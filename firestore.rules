rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: orders
    // Document ID: auto-generated
    // Fields:
    //   - gestor: string (required)
    //   - loja: string (required)
    //   - subGrupo: string
    //   - colecao: string
    //   - status: string
    //   - dataLancamento: string
    //   - mesRecebMaterial: string
    //   - material: string (required)
    //   - materialDescription: string
    //   - qtdeConfirmada: number (required)
    //   - valorNF: number (required)
    //   - syncDate: string
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master' ||
         request.auth.token.email == "hugotjk2@gmail.com");
    }

    // Master: dono do app (e-mail fixo) ou login com papel "master".
    function isMaster() {
      return isAuthenticated() &&
        (request.auth.token.email == "hugotjk2@gmail.com" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master');
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['gestor', 'loja', 'material', 'qtdeConfirmada', 'valorNF']) &&
             data.gestor is string && data.gestor.size() > 0 &&
             data.loja is string && data.loja.size() > 0 &&
             data.material is string && data.material.size() > 0 &&
             data.qtdeConfirmada is number &&
             data.valorNF is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /connection-test/{docId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && request.auth.token.email == "hugotjk2@gmail.com");
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rawPassword', 'needsPasswordReset', 'loginCount'])
      );
    }

    // Sugestão FW27: um pedido por login. Por enquanto só o master lê e grava.
    // Quando liberar para os franqueados: allow read, write: if isMaster() || (isAuthenticated() && request.auth.uid == userId);
    match /fw27Pedidos/{userId} {
      allow read, write: if isMaster();
    }

    // Histórico FW27: cópia de cada exportação/fechamento. Quem usa a tela grava; só o master lê.
    match /fw27Historico/{registroId} {
      allow create: if isMaster();
      allow read: if isMaster();
    }

    match /orders/{orderId} {
      // Allow authenticated users to read orders
      allow read: if isAuthenticated();
      
      // Only admins can write/delete orders (syncing is an admin task)
      allow write: if isAdmin() && isValidOrder(request.resource.data);
    }
  }
}
